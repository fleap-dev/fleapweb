---
// Base layout for every page: document head, header, and footer.
// Usage: <Layout title="Page">...</Layout>. Omit `title` on the home page.
import "@/styles/global.css"
import { site } from "@/site"
import { Button } from "@/components/ui/button"
import { MoonIcon, SunIcon } from "lucide-react"

interface Props {
  title?: string
  description?: string
}

const { title, description = site.description } = Astro.props
const pageTitle = title ? `${title} · ${site.title}` : site.title
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
    <!-- A saved preference takes priority over the OS, before the first paint. -->
    <script is:inline>
      const media = matchMedia("(prefers-color-scheme: dark)")
      let preference = null
      try {
        preference = localStorage.getItem("theme")
      } catch {}
      const sync = () => {
        document.documentElement.classList.toggle(
          "dark",
          preference === "dark" || (preference !== "light" && media.matches)
        )
      }
      sync()
      media.addEventListener("change", () => {
        try {
          preference = localStorage.getItem("theme")
        } catch {}
        sync()
      })
    </script>
  </head>
  <!-- Striped backdrop; the page itself is a centered journal "paper". -->
  <body class="reading-layout flex min-h-svh flex-col bg-stripes print:bg-none">
    <div class="reading-paper mx-auto flex w-full flex-1 flex-col bg-background">
      <header class="reading-masthead flex items-center print:hidden">
        <a href="/" class="font-heading text-sm font-semibold tracking-tight">
          {site.title}
        </a>
        <span class="masthead-caption">
          A notebook on software & other things
        </span>
        <Button
          id="theme-toggle"
          variant="ghost"
          size="icon-lg"
          aria-label="Toggle dark theme"
          aria-pressed="false"
        >
          <SunIcon className="theme-sun" />
          <MoonIcon className="theme-moon" />
        </Button>
      </header>
      <main class="flex flex-1 flex-col">
        <slot />
      </main>
      <footer class="reading-footer py-6 text-xs text-muted-foreground">
        <span>
          © {new Date().getFullYear()} {site.name}
        </span>
        <span>Built with care. Kept simple.</span>
      </footer>
    </div>
  </body>
</html>

<script>
  const toggle = document.querySelector<HTMLButtonElement>("#theme-toggle")
  const syncToggle = () => {
    toggle?.setAttribute(
      "aria-pressed",
      String(document.documentElement.classList.contains("dark"))
    )
  }
  syncToggle()
  toggle?.addEventListener("click", () => {
    const dark = document.documentElement.classList.toggle("dark")
    try {
      localStorage.setItem("theme", dark ? "dark" : "light")
    } catch {}
    syncToggle()
  })
  matchMedia("(prefers-color-scheme: dark)").addEventListener(
    "change",
    syncToggle
  )

  // Print in the light theme, then restore the reader's theme.
  let printedFromDark = false
  addEventListener("beforeprint", () => {
    printedFromDark = document.documentElement.classList.contains("dark")
    document.documentElement.classList.remove("dark")
  })
  addEventListener("afterprint", () => {
    document.documentElement.classList.toggle("dark", printedFromDark)
  })

  // On wide screens the margin card is fixed beside the paper (global.css).
  // It starts centered in the window, then rises with the page and stops 2rem
  // (32px) from the top. Narrower layouts ignore --margin-top.
  const card = document.querySelector<HTMLElement>(".journal-margin")
  if (card) {
    const place = () => {
      const start = (innerHeight - card.offsetHeight) / 2
      card.style.setProperty(
        "--margin-top",
        `${Math.max(32, start - scrollY)}px`
      )
    }
    place()
    addEventListener("scroll", place, { passive: true })
    addEventListener("resize", place)
  }
</script>

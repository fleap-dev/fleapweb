---
// Home page: a landing page set in the journal. A hero with the motto and a
// taped-in portrait, a figure that untangles a line, then featured papers,
// writing, and contact. All copy comes from src/site.ts.
import { Image } from "astro:assets"
import { getCollection } from "astro:content"
import { ArrowDownIcon, ArrowUpRightIcon } from "lucide-react"
import Layout from "@/layouts/main.astro"
import { Badge } from "@/components/ui/badge"
import { buttonVariants } from "@/components/ui/button"
import { formatDate } from "@/lib/date"
import { readingMinutes } from "@/lib/reading-time"
import { untanglePath } from "@/lib/untangle"
import { site } from "@/site"
import portrait from "@/assets/felipe.jpg"

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
)

// The motto, split around its two key words so each gets its own treatment:
// "complex" a wavy underline, "simply" a straight highlight.
const [before, complex, between, simply, after] =
  site.motto.split(/(complex|simply)/)

const cta = "h-10 gap-2 px-4 font-mono text-[0.8125rem]"
const metaRow = "flex gap-4 font-mono text-[0.6875rem] text-muted-foreground"
const titleLink =
  "font-heading text-xl font-medium tracking-tight text-balance underline decoration-transparent decoration-2 underline-offset-4 hover:decoration-primary"
---

<Layout>
  <div class="journal">
    <header class="grid items-center gap-x-16 gap-y-8 pt-4 md:grid-cols-[minmax(0,1fr)_15rem] md:pt-12">
      <figure class="polaroid w-36 md:order-last md:w-full">
        <Image
          src={portrait}
          alt={`Portrait of ${site.name}`}
          widths={[240, 460]}
          sizes="(min-width: 48rem) 15rem, 9rem"
          loading="eager"
          class="aspect-square w-full object-cover"
        />
        <figcaption>Fig. 1. {site.captions.portrait}</figcaption>
      </figure>

      <div class="flex flex-col items-start gap-6 md:gap-8">
        <p class="font-mono text-xs md:text-sm">
          <span class="font-semibold">{site.name}</span>
          <span class="text-muted-foreground"> / {site.role}</span>
        </p>
        <h1 class="font-heading text-[clamp(2.375rem,7vw,4.25rem)] leading-[1.14] font-medium tracking-[-0.065em]">
          {before}
          <span class="tangled">{complex}</span>
          {between}
          <span class="straight">{simply}</span>
          {after}
        </h1>
        <p class="max-w-[34rem] text-lg leading-[1.8] text-pretty text-muted-foreground">
          {site.about}
        </p>
        <nav
          aria-label="Start here"
          class="flex flex-wrap items-center gap-x-4 gap-y-4"
        >
          <a href="#writing" class={buttonVariants({ className: cta })}>
            Read the notes
            <ArrowDownIcon aria-hidden="true" />
          </a>
          <a
            href="#papers"
            class={buttonVariants({
              variant: "outline",
              className: `${cta} border-foreground/25!`,
            })}
          >
            Featured papers
          </a>
          {site.links.map((link) => (
            <a
              href={link.href}
              class="inline-flex items-center gap-1 font-mono text-[0.8125rem] underline decoration-primary decoration-2 hover:decoration-foreground"
            >
              {link.label}
              <ArrowUpRightIcon aria-hidden="true" className="size-3" />
            </a>
          ))}
        </nav>
      </div>
    </header>

    <!-- The motto as a drawing. The straight end doubles as the rule that
         closes the hero. -->
    <figure class="mt-12 md:mt-16">
      <div class="flex items-center">
        <svg
          viewBox="0 0 960 120"
          preserveAspectRatio="none"
          aria-hidden="true"
          class="h-20 min-w-0 flex-1 md:h-[7.5rem]"
        >
          <path
            d={untanglePath()}
            fill="none"
            stroke="currentColor"
            stroke-width="1.25"
            stroke-linejoin="round"
            vector-effect="non-scaling-stroke"
          ></path>
        </svg>
        <span class="size-3 shrink-0 bg-primary"></span>
      </div>
      <figcaption class="text-right font-mono text-[0.6875rem] text-muted-foreground">
        Fig. 2. {site.captions.untangle}
      </figcaption>
    </figure>

    <div class="journal-sections pt-10 pb-12 md:pt-14">
      <section id="papers">
        <h2>Featured papers</h2>
        <ol class="flex flex-col">
          {site.papers.map((paper) => (
            <li class="grid gap-x-8 gap-y-2 border-b py-6 first:pt-0 last:border-b-0 last:pb-0 md:grid-cols-[6rem_minmax(0,1fr)]">
              <div class={`${metaRow} md:flex-col md:gap-1`}>
                <span class="font-medium text-foreground md:font-heading md:text-xl md:tracking-tight">
                  {paper.venue}
                </span>
                <span aria-hidden="true" class="md:hidden">
                  /
                </span>
                <span>{paper.year}</span>
              </div>
              {paper.href ? (
                <a href={paper.href} class={`${titleLink} max-w-prose`}>
                  {paper.title}
                  <ArrowUpRightIcon
                    aria-hidden="true"
                    className="ml-1 inline size-3.5 align-baseline"
                  />
                </a>
              ) : (
                <span class="max-w-prose font-heading text-xl font-medium tracking-tight text-balance">
                  {paper.title}
                </span>
              )}
            </li>
          ))}
        </ol>
      </section>

      <section id="writing">
        <h2>Writing</h2>
        <ol class="flex flex-col">
          {posts.map((post) => (
            <li class="grid items-start gap-x-10 gap-y-5 border-b py-6 first:pt-0 last:border-b-0 last:pb-0 md:grid-cols-[minmax(0,1fr)_17rem]">
              <div class="flex flex-col gap-2">
                <div class={metaRow}>
                  <time datetime={post.data.date.toISOString()}>
                    {formatDate(post.data.date)}
                  </time>
                  <span aria-hidden="true">/</span>
                  <span>{readingMinutes(post.body)} min read</span>
                </div>
                <a href={`/blog/${post.id}`} class={`${titleLink} w-fit`}>
                  {post.data.title}
                </a>
                <p class="max-w-prose leading-relaxed text-muted-foreground">
                  {post.data.description}
                </p>
                <div class="flex flex-wrap gap-1.5 pt-1">
                  {post.data.tags.map((tag) => (
                    <Badge variant="outline">{tag}</Badge>
                  ))}
                </div>
              </div>
              <a
                href={`/blog/${post.id}`}
                tabindex="-1"
                aria-hidden="true"
                class="max-md:order-first"
              >
                <Image
                  src={post.data.cover.src}
                  alt=""
                  widths={[400, 800]}
                  sizes="(min-width: 48rem) 17rem, 100vw"
                  class="aspect-2/1 w-full rounded-md object-cover"
                />
              </a>
            </li>
          ))}
        </ol>
      </section>

      <section id="contact">
        <h2>Contact</h2>
        <p class="text-lg text-muted-foreground">{site.contact}</p>
        <a
          href={`mailto:${site.email}`}
          class="straight w-fit font-heading text-[clamp(1.75rem,6vw,3rem)] font-medium tracking-[-0.06em]"
        >
          {site.email}
        </a>
      </section>
    </div>
  </div>
</Layout>

<style>
  /* A photo taped into the journal: white frame, a strip of tape, a tilt. */
  .polaroid {
    position: relative;
    padding: 0.5rem 0.5rem 0;
    border: 1px solid var(--border);
    background: var(--card);
    box-shadow:
      0 1px 2px oklch(0 0 0 / 6%),
      0 12px 24px -12px oklch(0 0 0 / 18%);
    rotate: 2deg;
  }
  .polaroid::before {
    content: "";
    position: absolute;
    top: -0.7rem;
    left: 50%;
    width: 38%;
    height: 1.3rem;
    background: color-mix(in oklch, var(--primary) 70%, transparent);
    translate: -50% 0;
    rotate: -4deg;
  }
  .polaroid figcaption {
    padding-block: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    color: var(--muted-foreground);
  }

  /* The two halves of the motto: a wavy line under the complex part, a
     highlighter stroke over the simple one. */
  .tangled {
    text-decoration: underline wavy var(--muted-foreground);
    text-decoration-thickness: 0.04em;
    text-underline-offset: 0.16em;
    text-decoration-skip-ink: none;
  }
  .straight {
    --ink: color-mix(in oklch, var(--primary) 75%, transparent);
    background: linear-gradient(
      transparent 56%,
      var(--ink) 56% 92%,
      transparent 92%
    );
  }
  :global(.dark) .straight {
    --ink: color-mix(in oklch, var(--primary) 45%, transparent);
  }
</style>

---
// Served by nginx (see nginx.conf) for any missing URL, at any depth,
// so every link here starts with "/".
import AnimatedLogo from "../components/AnimatedLogo.astro";
import AnimatedSeparator from "../components/AnimatedSeparator.astro";
import Code from "../components/Code.astro";
import Layout from "../layouts/Layout.astro";

const navItems = [
  { title: "Home", href: "/" },
  { title: "About", href: "/#about" },
  { title: "Links", href: "/#links" },
];
---

<Layout title="404 · FleapWEB">
  <header>
    <nav
      class="p-8 w-full flex items-center justify-center border-b border-zinc-600 bg-[#303030]"
      aria-label="Global"
    >
      <div class="flex gap-4 lg:gap-x-12">
        {
          navItems.map((item) => (
            <a href={item.href} class="text-sm font-semibold leading-6 text-white">
              {item.title}
            </a>
          ))
        }
      </div>
    </nav>
  </header>

  <div class="flex items-center flex-col justify-center h-[500px]">
    <div
      style="background-color: rgba(255, 0, 0, 0.2); border-color: rgba(255, 0, 0, 0.4);"
      class="rounded-full border py-1 px-4 text-white font-medium"
    >
      ⚠ Página não encontrada ⚠
    </div>
    <AnimatedLogo text="404" />
  </div>

  <div class="w-full border-y border-zinc-600 bg-[#303030] p-8">
    <div class="mx-auto max-w-2xl">
      <div class="w-full flex flex-col items-center justify-center">
        <div class="w-32">
          <AnimatedSeparator />
        </div>
        <h1 class="p-4 text-white text-xl font-bold tracking-tight">Nada por aqui</h1>
        <p class="text-base text-center text-zinc-400 mb-4">
          O endereço que você tentou acessar não existe ou foi removido.
        </p>
        <Code>
          <span class="code-error font-bold">ERRO:</span><span
            id="request"
            class="code break-all">{" "}404 Not Found</span
          >
        </Code>
      </div>
    </div>
  </div>

  <div class="flex justify-center p-8">
    <a href="/">
      <div
        class="bg-[#303030] p-2 px-8 border border-zinc-600 shadow rounded-xl flex flex-col items-center justify-center duration-500 hover:scale-110 cursor-pointer"
      >
        <span class="p-4 text-white text-lg font-medium tracking-tight">Voltar ao início</span>
      </div>
    </a>
  </div>

  <div class="p-8">
    <h1 class="text-center">
      <a href="mailto:fleap@fleap.dev" class="text-white font-bold">fleap@fleap.dev</a>
    </h1>
  </div>
</Layout>

<script is:inline>
  // Show the missing path in the terminal line. textContent keeps the URL from being parsed as HTML.
  document.getElementById("request").textContent =
    " GET " + location.pathname + " → 404 Not Found";
</script>

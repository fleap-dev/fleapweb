---
// Internal design-system showcase. Not linked from the site and not indexed.
// The journal layout supplies the masthead, theme toggle and paper; the React
// showcase renders the numbered sections listed in `sections` below.
import { ArrowLeftIcon } from "lucide-react"
import Layout from "@/layouts/main.astro"
import { Showcase } from "@/showcase/showcase"

// Keep in the order the showcase renders them; ids match each <Section id>.
const sections = [
  ["foundations", "Foundations"],
  ["actions", "Actions"],
  ["inputs", "Inputs"],
  ["navigation", "Navigation"],
  ["data-display", "Data"],
  ["feedback", "Feedback"],
  ["overlays", "Overlays"],
  ["conversation", "Conversation"],
  ["direction", "Right-to-left"],
] as const
---

<Layout
  title="Design system"
  description="Every token and component the site can use."
  noindex
>
  <div class="journal">
    <header class="journal-header">
      <div class="journal-eyebrow">
        <a href="/"><ArrowLeftIcon aria-hidden="true" /> Front page</a>
        <span>Internal, not indexed</span>
      </div>
      <h1>Design system</h1>
      <p class="journal-deck">
        Every token and component the site can use, rendered with the current
        theme. Change <code class="font-mono">global.css</code> or a component's
        variants and check the result here.
      </p>
      <div class="journal-meta">
        <span class="text-muted-foreground">
          src/styles/global.css / src/components/ui
        </span>
        <span class="text-muted-foreground">{sections.length} sections</span>
      </div>
    </header>

    <div class="journal-body">
      <aside class="journal-margin">
        <nav aria-label="On this page" class="journal-margin-inner">
          <h2 class="margin-label">On this page</h2>
          <ol class="journal-index">
            {sections.map(([id, label], index) => (
              <li>
                <a href={`#${id}`}>
                  <span aria-hidden="true">
                    {String(index + 1).padStart(2, "0")}
                  </span>
                  {label}
                </a>
              </li>
            ))}
          </ol>
        </nav>
      </aside>
      <div class="min-w-0">
        <Showcase client:only="react" />
      </div>
    </div>
  </div>
</Layout>
